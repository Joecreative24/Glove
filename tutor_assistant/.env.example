# Anthropic credentials: set this OR run `ant auth login`.
ANTHROPIC_API_KEY=

# Where the SQLite database lives (default: ~/.tutor_assistant/tutor.db)
TUTOR_DB=

# Optional overrides
TUTOR_MODEL=claude-opus-5
TUTOR_TIMEZONE=Europe/London

# Google (only needed for Drive share links / Gmail drafts / Calendar push)
# Path to the OAuth client secret downloaded from Google Cloud Console.
GOOGLE_CLIENT_SECRET_FILE=
# Where the OAuth token is cached after the first login.
GOOGLE_TOKEN_FILE=~/.tutor_assistant/google_token.json
