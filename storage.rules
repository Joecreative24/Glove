rules_version = '2';

// ═══════════════════════════════════════════════════════════════════════════
//  Cloud Storage rules — profile photos for the Intelligent Glove app.
//
//  Photos live at:  profile_photos/{userId}/{fileName}
//  Only the owner may upload/replace/delete their own photo.
//  Anyone signed-in may read a photo (so avatars render in shared screens).
// ═══════════════════════════════════════════════════════════════════════════

service firebase.storage {
  match /b/{bucket}/o {

    match /profile_photos/{userId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024          // max 5 MB
                   && request.resource.contentType.matches('image/.*'); // images only
    }

    // Everything else is denied by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
